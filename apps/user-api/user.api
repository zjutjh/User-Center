syntax = "v1"

info (
	title:  "精弘用户中心"
	desc:   "精弘用户中心 powered by go-zero"
	author: "MangoGovo"
	email:  "1749100231@qq.com"
)

type (
	BindInfo {
		Zf    bool `json:"zf"`
		Yxy   bool `json:"yxy"`
		Oauth bool `json:"oauth"`
	}
	UserInfo {
		Id         int64    `json:"id"`
		Username   string   `json:"username"`
		StudentId  string   `json:"studentId"`
		Bind       BindInfo `json:"bind"`
		UserType   string   `json:"userType"`
		Email      string   `json:"email,optional"`
		PhoneNum   string   `json:"phoneNum,optional"`
		CreateTime string   `json:"createTime"`
	}
)

type (
	CreateStudentReq {
		StudentId string `json:"studentId"`
		Password  string `json:"password"`
		CardId    string `json:"cardId"`
		Email     string `json:"email,optional"`
	}
	LoginReq {
		Username string `json:"username"`
		Password string `json:"password"`
	}
	MiniProgramLoginReq {
		AppType string `json:"appType"`
		Code    string `json:"code"`
	}
	ResetPasswordReq {
		IdCard    string `json:"iid"`
		StudentId string `json:"stuid"`
		Password  string `json:"password"`
	}
	DeleteAccountReq {
		IdCard    string `json:"iid"`
		StudentId string `json:"stuid"`
	}
)

type (
	EmptyResp  {}
	CreateStudentResp {
		UserId int64 `json:"userId"`
	}
	UserResp {
		User UserInfo `json:"user"`
	}
)

@server (
	tags:   "用户注册"
	group:  user
	prefix: /api/user
)
service user-api {
	@doc "创建学生账号"
	@handler CreateStudent
	post /create/student (CreateStudentReq) returns (CreateStudentResp)
}

@server (
	tags:   "用户登录"
	group:  login
	prefix: /api/user
)
service user-api {
	@doc "账号密码登录"
	@handler LoginByPassword
	post /login/password (LoginReq) returns (UserResp)

	@doc "统一登录"
	@handler LoginByOauth
	post /login/oauth (LoginReq) returns (UserResp)

	@doc "小程序登录"
	@handler LoginByMiniProgram
	post /login/mini-program (MiniProgramLoginReq) returns (UserResp)
}

@server (
	tags:       "用户操作"
	group:      user
	prefix:     /api/user
	middleware: UserAuth
)
service user-api {
	@doc "用户信息"
	@handler Info
	post /info returns (UserResp)

	@doc "重置密码"
	@handler Repass
	post /repass (ResetPasswordReq) returns (EmptyResp)

	@doc "注销账号"
	@handler Del
	post /del (DeleteAccountReq) returns (EmptyResp)
}

